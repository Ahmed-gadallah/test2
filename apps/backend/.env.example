# ─── Zaad backend configuration ───────────────────────────────────────────────
# Copy to .env for local development. NEVER commit real secrets.

NODE_ENV=development            # development | test | production
PORT=3000
DATABASE_URL=postgres://zaad:zaad@localhost:5432/zaad
CORS_ORIGINS=*                  # comma-separated origins in production (admin dashboard URL)

# Token secrets: 32+ random chars each, all different. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ADMIN_SECRET=change-me-admin-secret-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900    # 15 min
REFRESH_TOKEN_TTL_DAYS=60       # session lifetime; rotated on every refresh
VERIFICATION_TOKEN_TTL_SECONDS=600

# OTP. console = prints codes to the server log (dev only, refused in production).
OTP_PROVIDER=console            # console | whatsapp | sms   (whatsapp/sms not implemented: provider not chosen)
OTP_FALLBACK_PROVIDER=none      # none | sms
OTP_TTL_SECONDS=300
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
# OTP_DEV_FIXED_CODE=123456     # dev/demo convenience only; refused in production

# ERP. mock = fictional in-memory data (refused in production). http = vendor API (contract pending).
ERP_ADAPTER=mock                # mock | http
# ERP_BASE_URL=https://erp-vendor.example/api
ERP_TIMEOUT_MS=8000

PUSH_PROVIDER=console           # console | fcm  (fcm not implemented: needs Zaad Firebase project)

POINTS_PER_SAR=50               # display conversion, verified against ERP data
BALANCE_CACHE_SECONDS=30
ONLINE_STORE_URL=https://zaadonline.com
